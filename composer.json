{
    "name": "eideasy/spid-php-lib",
    "description": "PHP package for SPID authentication",
    "type": "library",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Mats-Joonas Kulla",
            "email": "mj@eideasy.com"
        }
    ],
    "require": {
        "robrichards/xmlseclibs": "^3.0",
        "php": "^7.4 || ^8.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.3",
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
